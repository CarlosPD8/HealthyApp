#!/bin/sh

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "ERROR: gitleaks no esta instalado o no esta en el PATH."
  echo "Instalacion: https://github.com/gitleaks/gitleaks#installing"
  echo "Despues vuelve a ejecutar git commit."
  exit 1
fi

gitleaks git --pre-commit --redact --staged --verbose
